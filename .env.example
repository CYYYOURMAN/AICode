# DSH 引擎需要的模型 API key（必填）
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 网关共享密钥；留空则首次启动自动生成（docker compose logs 里会打印配对码，
# 密钥在容器内 /data/secret：docker compose exec aicode cat /data/secret）
GATEWAY_SECRET=

# 端口（host 网络）
GATEWAY_PORT=3300
DSH_PORT=3080
DSH_HOST=127.0.0.1

# 功能开关
PHONE_ENABLED=1
EXEC_ENABLED=0

# 套了 HTTPS 反代后，填 App 应访问的引擎根地址（例如 https://aicode.example.com）
# 留空则按请求 Host 推断（http）
DSH_BASE=
